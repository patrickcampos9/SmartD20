<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:D20Mobile.Models;assembly=SmartD20.Core"
             x:Class="D20Mobile.Views.MainPage"
             Title="SmartD20">

    <Grid RowDefinitions="Auto,Auto,*,Auto"
          Padding="24"
          RowSpacing="18">
        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label Text="SmartD20"
                   FontSize="30"
                   FontAttributes="Bold"
                   SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Encontre e conecte seu relógio por Bluetooth"
                   TextColor="{AppThemeBinding Light=#404040, Dark=#ACACAC}" />
        </VerticalStackLayout>

        <Border Grid.Row="1" Padding="16" StrokeShape="RoundRectangle 14">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <ActivityIndicator x:Name="BusyIndicator"
                                   IsRunning="False"
                                   IsVisible="False"
                                   WidthRequest="24" />
                <Label x:Name="StatusLabel"
                       Grid.Column="1"
                       VerticalTextAlignment="Center"
                       LineBreakMode="WordWrap" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="10">
            <Label Text="Dispositivos encontrados"
                   FontSize="18"
                   FontAttributes="Bold" />

            <CollectionView x:Name="DevicesList"
                            Grid.Row="1"
                            SelectionMode="Single"
                            SelectionChanged="OnDeviceSelected"
                            EmptyView="Toque em Procurar para buscar dispositivos Bluetooth próximos.">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:WatchDevice">
                        <Border Margin="0,4" Padding="14" StrokeShape="RoundRectangle 12">
                            <Grid RowDefinitions="Auto,Auto"
                                  ColumnDefinitions="*,Auto"
                                  ColumnSpacing="12">
                                <Label Text="{Binding Name}"
                                       FontAttributes="Bold"
                                       FontSize="16" />
                                <Label Grid.Column="1"
                                       Text="{Binding SignalText}"
                                       VerticalTextAlignment="Center" />
                                <Label Grid.Row="1"
                                       Text="{Binding SourceText}"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light=#6E6E6E, Dark=#ACACAC}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="12">
            <Button x:Name="ScanButton"
                    Text="Procurar"
                    Clicked="OnScanClicked" />
            <Button x:Name="ConnectionButton"
                    Grid.Column="1"
                    Text="Conectar"
                    IsEnabled="False"
                    Clicked="OnConnectionClicked" />
        </Grid>
    </Grid>
</ContentPage>
